    <description>&lt;p&gt;&lt;img src="https://scontent-sjc6-1.cdninstagram.com/v/t51.82787-15/732104740_18331519756265096_7064721566698198790_n.jpg?stp=dst-jpg_e35_tt6&amp;_nc_cat=108&amp;ccb=7-5&amp;_nc_sid=18de74&amp;efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&amp;_nc_ohc=kf-HMcOgU-cQ7kNvwFHUTL8&amp;_nc_oc=AdoKGipTidPM3hOuacpNPboyR2GH6OLDWRTskTNSKCdUtD6cBMOCVjFGumNTdemQzVI&amp;_nc_zt=23&amp;_nc_ht=scontent-sjc6-1.cdninstagram.com&amp;edm=AM6HXa8EAAAA&amp;_nc_gid=BCvhMtWoerbY3kpNl4beJg&amp;oh=00_AQGS4pUPeIZgdSBeDI3PpYXSLErvuladUZzui_yTNE2edw&amp;oe=6A94A662" style="max-width: 500px; max-height: 500px" class="fb-feed-image"&gt;&lt;/p&gt;
