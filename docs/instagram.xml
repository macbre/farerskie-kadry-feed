    <description>&lt;p&gt;&lt;img src="https://scontent-sjc6-1.cdninstagram.com/v/t51.82787-15/732104740_18331519756265096_7064721566698198790_n.jpg?stp=dst-jpg_e35_tt6&amp;_nc_cat=108&amp;ccb=7-5&amp;_nc_sid=18de74&amp;efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&amp;_nc_ohc=hQprAAYLaMYQ7kNvwElybl-&amp;_nc_oc=AdqyjNKbx8igCPQ1vf1lEPz22aNLsSJHhaTIdcrojvFwFrbWO87AAtsk5hpaZEG7wK4&amp;_nc_zt=23&amp;_nc_ht=scontent-sjc6-1.cdninstagram.com&amp;edm=AM6HXa8EAAAA&amp;_nc_gid=Z0QjnX2CpTKkAChGUPAnlg&amp;oh=00_AQJChOGf8ffja7CgON-lANvYBYIDqRF4z3NF0NaF_owsWQ&amp;oe=6AB725A2" style="max-width: 500px; max-height: 500px" class="fb-feed-image"&gt;&lt;/p&gt;
