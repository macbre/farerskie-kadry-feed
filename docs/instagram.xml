    <description>&lt;p&gt;&lt;img src="https://scontent-sjc6-1.cdninstagram.com/v/t51.82787-15/732104740_18331519756265096_7064721566698198790_n.jpg?stp=dst-jpg_e35_tt6&amp;_nc_cat=108&amp;ccb=7-5&amp;_nc_sid=18de74&amp;efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&amp;_nc_ohc=3wO-ao5GCGIQ7kNvwHe8Jlo&amp;_nc_oc=AdpGeotHzb5qe8sKNXCtFd-JwYqDwGh_-rdd4s6XBfRQGzVwlTAu3wVffUQ8Oj3CS4o&amp;_nc_zt=23&amp;_nc_ht=scontent-sjc6-1.cdninstagram.com&amp;edm=AM6HXa8EAAAA&amp;_nc_gid=a_1hFwt-f7wMsCb6Nj6ANw&amp;oh=00_AQJbg9ed6mxH4CpMlEcUrY7VS0Om2q9XGPvygzQ1oBZfTg&amp;oe=6AA60222" style="max-width: 500px; max-height: 500px" class="fb-feed-image"&gt;&lt;/p&gt;
